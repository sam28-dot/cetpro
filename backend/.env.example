# Server
PORT=5000
NODE_ENV=development

# MongoDB - Replace with your MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cetpro?retryWrites=true&w=majority

# JWT Secrets - Generate strong random strings for production
JWT_SECRET=your_super_secret_jwt_key_replace_this_in_production_min_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_replace_this_too_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer - use your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@cetpredictorpro.in

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
